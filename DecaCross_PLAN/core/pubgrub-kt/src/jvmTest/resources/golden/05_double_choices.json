{
  "name": "double_choices",
  "origin": "pubgrub-rs tests/examples.rs::double_choices (루트를 root→a 로 감쌈)",
  "packages": {
    "a": { "0.0.0": { "b": "*", "c": "*" } },
    "b": { "0.0.0": { "d": "0.0.0" }, "1.0.0": { "d": "1.0.0" } },
    "c": { "0.0.0": {}, "1.0.0": { "d": "2.0.0" } },
    "d": { "0.0.0": {} }
  },
  "root": { "a": "*" },
  "expect": { "solution": { "a": "0.0.0", "b": "0.0.0", "c": "0.0.0", "d": "0.0.0" } }
