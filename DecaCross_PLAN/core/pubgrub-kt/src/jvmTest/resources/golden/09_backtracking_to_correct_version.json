{
  "name": "backtracking_to_correct_version",
  "origin": "prompts/P1 예시 이름 — 최신 a 3.0.0 은 b 와 c 에서 막혀 a 2.0.0 으로 되돌아간다",
  "packages": {
    "a": { "3.0.0": { "c": "^3.0.0" }, "2.0.0": { "c": ">=1.0.0 <3.0.0" }, "1.0.0": {} },
    "b": { "1.0.0": { "c": ">=1.0.0 <3.0.0" } },
    "c": { "1.0.0": {}, "2.0.0": {}, "3.0.0": {} }
  },
  "root": { "a": "*", "b": "*" },
  "expect": { "solution": { "a": "2.0.0", "b": "1.0.0", "c": "2.0.0" } }
}
