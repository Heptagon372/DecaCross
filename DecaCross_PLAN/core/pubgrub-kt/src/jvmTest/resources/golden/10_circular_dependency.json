{
  "name": "circular_dependency",
  "origin": "Dart pub solver 테스트 (순환 의존) 재구성",
  "packages": {
    "a": { "1.0.0": { "b": "*" } },
    "b": { "1.0.0": { "a": "*", "c": "*" } },
    "c": { "1.0.0": { "b": "^1.0.0" } }
  },
  "root": { "a": "*" },
  "expect": { "solution": { "a": "1.0.0", "b": "1.0.0", "c": "1.0.0" } }
}
